rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function careLinkPath(uid) { return /databases/$(db)/documents/careLinks/$(uid); }
    function isCaregiverOf(uid) {
      return signedIn() && exists(careLinkPath(uid))
        && get(careLinkPath(uid)).data.caregiverUid == request.auth.uid;
    }
    function isManaged(uid) { return exists(careLinkPath(uid)); }

    // Who may add/edit/delete medications of profile `pid` owned by `uid`.
    function canManage(uid, pid) {
      return (isOwner(uid) && (pid != 'self' || !isManaged(uid)))
          || (pid == 'self' && isCaregiverOf(uid));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isCaregiverOf(uid);
      allow write: if isOwner(uid);

      match /profiles/{pid} {
        allow read: if isOwner(uid) || isCaregiverOf(uid);
        allow write: if isOwner(uid);

        match /medications/{mid} {
          allow read: if isOwner(uid) || (pid == 'self' && isCaregiverOf(uid));
          allow create, delete: if canManage(uid, pid);
          // Elder under care may only change the stock counter (dose confirmation).
          allow update: if canManage(uid, pid)
            || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining']));
        }

        match /doseLogs/{lid} {
          allow read: if isOwner(uid) || (pid == 'self' && isCaregiverOf(uid));
          allow write: if isOwner(uid) || (pid == 'self' && isCaregiverOf(uid));
        }
      }

      // Written by Cloud Functions only.
      match /notifications/{nid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // One-time QR tokens (unguessable 32-char ids).
    match /linkTokens/{token} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
        && request.resource.data.usedBy == request.auth.uid;
    }

    match /careLinks/{elderUid} {
      allow read: if isOwner(elderUid)
        || (signedIn() && resource != null && resource.data.caregiverUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.caregiverUid == request.auth.uid
        && request.resource.data.elderUid == elderUid
        && getAfter(/databases/$(db)/documents/linkTokens/$(request.resource.data.token)).data.used == true
        && getAfter(/databases/$(db)/documents/linkTokens/$(request.resource.data.token)).data.ownerUid == elderUid
        && getAfter(/databases/$(db)/documents/linkTokens/$(request.resource.data.token)).data.usedBy == request.auth.uid;
      // Only the elder can unlink for now (open policy decision in the spec).
      allow delete: if isOwner(elderUid);
    }
  }
}
